# Copy outside every Git repository. Set mode 600 before adding values.
# Plain KEY=value only. Blank values use the terminal prompt.
# No quotes, export, shell expansion or inline comments.
# Any value may instead be an op://vault/item/field reference (1Password CLI).

# Choose in your password manager: at least 16 characters, kept for recovery.
# No console copy exists. Needed: init, plan, summary, approve, apply,
# plan-destroy and retire.
STATE_PASSPHRASE=

# Console map: hetzner.project-token. Needed: plan, apply, plan-destroy,
# retire and lane.py.
HETZNER_PROJECT_TOKEN=

# Console map: hetzner.storage-keys. Keep both fields.
# Needed: preflight, init, plan, summary, approve, apply, plan-destroy and retire.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Console map: tailscale.auth-key.
# Needed: plan only. Add it last, after preflight passes: its one day starts at
# creation. Replace for a new enrolment; never reuse a spent key.
TAILSCALE_AUTH_KEY=

# Console map: coolify.team-token.
# Needed: discover, every run stage, check.py and lane.py.
COOLIFY_TEAM_TOKEN=

# Console map: tailscale.read-credential. Recommended, separate read-only scopes.
# Needed: preflight, plan, run register, start-register and record.
TAILSCALE_READ_CLIENT_ID=
TAILSCALE_READ_CLIENT_SECRET=

# Console map: tailscale.access-token. Fallback only, full creating-user API
# permissions, never a read-only token. Use one day; revoke after setup.
TAILSCALE_API_TOKEN=

# Console map: tailscale.docktail-credential. This is the write credential.
# Needed: run oauth-id and run oauth-secret respectively, sent to docktail.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
