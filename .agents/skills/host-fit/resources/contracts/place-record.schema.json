{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Host Kit place record v1",
  "description": "Owned by AI Host Kit. Kept in the organisation's private place repository. Records the encrypted state location, never its key. Records are declarations, not proof of network rules, encryption or recovery.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "place": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[\\s\\S]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "server",
            "cloud",
            "existing"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[\\s\\S]*$"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[\\s\\S]*$"
        }
      },
      "required": [
        "name",
        "organisation",
        "kind",
        "provider",
        "region"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "format": "cidr"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "private_access": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[\\s\\S]*$"
        }
      },
      "required": [
        "cidrs",
        "private_access"
      ],
      "additionalProperties": false
    },
    "firewall": {
      "type": "object",
      "properties": {
        "default_inbound": {
          "const": "deny"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "protocol": {
                "type": "string",
                "enum": [
                  "tcp",
                  "udp"
                ]
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "format": "cidr"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[\\s\\S]*$"
              }
            },
            "required": [
              "protocol",
              "ports",
              "sources",
              "purpose"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "default_inbound",
        "rules"
      ],
      "additionalProperties": false
    },
    "backup_storage": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[\\s\\S]*$"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*\\s)(?:https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?|s3://[a-z0-9][a-z0-9.-]*)(?:/[A-Za-z0-9._~/-]*)?$"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[\\s\\S]*$"
        },
        "encrypted": {
          "const": true
        }
      },
      "required": [
        "provider",
        "location",
        "region",
        "encrypted"
      ],
      "additionalProperties": false
    },
    "alert_addresses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![\\s\\S]*\\s)[A-Za-z0-9._+-]+@[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?\\.[A-Za-z]{2,}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "host_record": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\s\\S]*\\s)(?:https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~/-]*)?|(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_~-][A-Za-z0-9._~/-]*)$"
          }
        },
        "required": [
          "name",
          "host_record"
        ],
        "additionalProperties": false
      }
    },
    "encrypted_state": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*\\s)(?:https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?|s3://[a-z0-9][a-z0-9.-]*)(?:/[A-Za-z0-9._~/-]*)?$"
        },
        "encryption": {
          "type": "string",
          "enum": [
            "AES-GCM",
            "AES-256-GCM",
            "ChaCha20-Poly1305"
          ]
        },
        "key_custodian": {
          "type": "string",
          "minLength": 1,
          "description": "The person who keeps the key. Never put the key in this record.",
          "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[\\s\\S]*$"
        }
      },
      "required": [
        "location",
        "encryption",
        "key_custodian"
      ],
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "properties": {
        "host": {
          "enum": [
            "coolify-hetzner",
            "vercel-postgres",
            "azure",
            "existing"
          ]
        },
        "proven": {
          "type": "boolean"
        },
        "answers": {
          "type": "object",
          "properties": {
            "cloud": {
              "enum": [
                "azure",
                "aws",
                "google-cloud",
                "none",
                "not-sure"
              ]
            },
            "care": {
              "enum": [
                "managed",
                "server",
                "no-preference"
              ]
            },
            "long_work": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "wish": {
          "enum": [
            "aws",
            "google-cloud"
          ]
        },
        "accepted_shortfalls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "enum": [
                  "image.dockerfile",
                  "processes.web.command",
                  "processes.web.port",
                  "processes.worker.command",
                  "processes.migrate.command",
                  "processes.migrate.when",
                  "health.path",
                  "health.checks",
                  "health.commit_env",
                  "config.*.name",
                  "config.*.kind",
                  "config.*.phase",
                  "config.*.source",
                  "postgres.min_major",
                  "postgres.extensions",
                  "postgres.roles.migrate",
                  "postgres.roles.app",
                  "files.port",
                  "files.buckets.*.name",
                  "files.buckets.*.private",
                  "files.buckets.*.link_minutes",
                  "email.transport",
                  "email.sender_domain",
                  "email.inbound",
                  "jobs.library",
                  "jobs.runner",
                  "jobs.longest_job_seconds",
                  "jobs.schedules.*.name",
                  "jobs.schedules.*.cron",
                  "sign_in.staff.provider",
                  "sign_in.staff.directory",
                  "sign_in.staff.outside_refused_test",
                  "sign_in.staff.redirect_path",
                  "sign_in.outsiders",
                  "ai.needed",
                  "ai.capabilities",
                  "ai.residency",
                  "access",
                  "residency",
                  "data_risk",
                  "recovery.max_data_loss_hours",
                  "recovery.max_restore_hours",
                  "limits.longest_request_seconds",
                  "limits.memory_mb",
                  "limits.outbound_internet",
                  "previews.wanted",
                  "previews.data"
                ]
              },
              "status": {
                "const": "accepted"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "words": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[^\\r\\n]+$"
              }
            },
            "required": [
              "field",
              "status",
              "date",
              "words"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "host",
        "proven",
        "answers",
        "accepted_shortfalls"
      ],
      "additionalProperties": false
    },
    "phase": {
      "const": "place"
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server_id": {
          "type": "integer",
          "minimum": 1
        },
        "firewall_id": {
          "type": "integer",
          "minimum": 1
        },
        "ssh_key_id": {
          "type": "integer",
          "minimum": 1
        },
        "public_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "tailnet_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coolify": {
              "const": "4.3.23"
            },
            "mcp": {
              "const": "3.9.0"
            },
            "docktail": {
              "const": "1.8.6"
            },
            "hcloud": {
              "const": "1.70.2"
            }
          },
          "required": [
            "coolify",
            "mcp",
            "docktail",
            "hcloud"
          ]
        },
        "plumbing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project_uuid": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+$"
            },
            "docktail_uuid": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+$"
            },
            "canary_uuid": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+$"
            },
            "tailnet_service_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+$"
            }
          },
          "required": [
            "project_uuid",
            "docktail_uuid",
            "canary_uuid",
            "tailnet_service_name"
          ]
        },
        "journal": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": [
        "server_id",
        "firewall_id",
        "ssh_key_id",
        "public_ipv4",
        "tailnet_ipv4",
        "versions"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "anyOf": [
    {
      "required": [
        "schema_version",
        "place",
        "network",
        "firewall",
        "backup_storage",
        "alert_addresses",
        "tools",
        "encrypted_state"
      ]
    },
    {
      "required": [
        "phase",
        "infrastructure",
        "place",
        "network",
        "firewall",
        "tools",
        "encrypted_state"
      ]
    },
    {
      "required": [
        "choice"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "place"
            ]
          },
          {
            "required": [
              "network"
            ]
          },
          {
            "required": [
              "firewall"
            ]
          },
          {
            "required": [
              "backup_storage"
            ]
          },
          {
            "required": [
              "alert_addresses"
            ]
          },
          {
            "required": [
              "tools"
            ]
          },
          {
            "required": [
              "encrypted_state"
            ]
          },
          {
            "required": [
              "phase"
            ]
          },
          {
            "required": [
              "infrastructure"
            ]
          }
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "tools": {
            "maxItems": 0
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "backup_storage"
              ]
            },
            {
              "required": [
                "alert_addresses"
              ]
            }
          ]
        }
      }
    }
  ]
}
