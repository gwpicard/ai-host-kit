  "additionalProperties": false,
  "$defs": {
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "met"
            },
            "check": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![\\s\\S]*\\s)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_~-][A-Za-z0-9._~/-]*$"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "met-if"
            },
            "condition": {
              "type": "object",
              "properties": {
                "field": {
                  "enum": [
                    "image.dockerfile",
                    "processes.web.command",
                    "processes.web.port",
                    "processes.worker.command",
                    "processes.migrate.command",
                    "processes.migrate.when",
                    "health.path",
                    "health.checks",
                    "health.commit_env",
                    "config.*.name",
                    "config.*.kind",
                    "config.*.phase",
                    "config.*.source",
                    "postgres.min_major",
                    "postgres.extensions",
                    "postgres.roles.migrate",
                    "postgres.roles.app",
                    "files.port",
                    "files.buckets.*.name",
                    "files.buckets.*.private",
                    "files.buckets.*.link_minutes",
                    "email.transport",
                    "email.sender_domain",
                    "email.inbound",
                    "jobs.library",
                    "jobs.runner",
                    "jobs.longest_job_seconds",
                    "jobs.schedules.*.name",
                    "jobs.schedules.*.cron",
                    "sign_in.staff.provider",
                    "sign_in.staff.directory",
                    "sign_in.staff.outside_refused_test",
                    "sign_in.staff.redirect_path",
                    "sign_in.outsiders",
                    "ai.needed",
                    "ai.capabilities",
                    "ai.residency",
                    "access",
                    "residency",
                    "data_risk",
                    "recovery.max_data_loss_hours",
                    "recovery.max_restore_hours",
                    "limits.longest_request_seconds",
                    "limits.memory_mb",
                    "limits.outbound_internet",
                    "previews.wanted",
                    "previews.data"
                  ]
                },
                "operator": {
                  "enum": [
                    "eq",
                    "in",
                    "lte",
                    "gte"
                  ]
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[^\\r\\n]+$"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "oneOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[^\\r\\n]+$"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              "required": [
                "field",
                "operator",
                "value"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "operator": {
                        "enum": [
                          "lte",
                          "gte"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "operator": {
                        "const": "in"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "array"
                      }
                    }
                  }
                }
              ]
            },
            "check": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![\\s\\S]*\\s)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_~-][A-Za-z0-9._~/-]*$"
            }
          },
          "required": [
            "status",
            "condition"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "cannot"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![\\s\\S]*[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*[@?#%\\\\])[^\\r\\n]+$"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
