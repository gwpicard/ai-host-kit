# Copy outside every Git repository. Set mode 600 before adding values.
# Plain KEY=value only. Blank values use the terminal prompt.
# No quotes, export, shell expansion or inline comments.
# Any value may instead be an op://vault/item/field reference (1Password CLI).

# Choose in your password manager: at least 16 characters, kept for recovery.
# No console copy exists. Needed: init, plan, summary, approve, apply,
# plan-destroy and retire.
STATE_PASSPHRASE=

# Hetzner Console > selected project > Security > API tokens > Generate API token.
# Read/write token, shown only once. Needed: plan, apply, plan-destroy,
# retire and lane.py.
HETZNER_PROJECT_TOKEN=

# Hetzner Console > Object Storage > S3 credentials > Generate credentials.
# Access key is an identifier; secret key is shown only once. Keep both.
# Needed: init, plan, summary, approve, apply, plan-destroy and retire.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Tailscale admin console > Settings > Keys > Generate auth key.
# Shown only once. Single-use, pre-approved tag:server, non-ephemeral.
# Needed: plan only. Replace for a new enrolment; never reuse a spent key.
TAILSCALE_AUTH_KEY=

# Coolify > Keys & Tokens > API tokens > Create New Token.
# Shown only once. Whole team: read, read:sensitive, write, deploy; never root.
# Needed: discover, every run stage, check.py and lane.py.
COOLIFY_TEAM_TOKEN=

# Tailscale admin console > Settings > Keys > Generate API access token.
# Shown only once. Needed: run register, start-register and record (service reads).
TAILSCALE_API_TOKEN=

# Tailscale admin console > Settings > OAuth clients > Generate OAuth client.
# Client ID remains an identifier; client secret is shown only once.
# Review service registration abilities before creating the client.
# Needed: run oauth-id and run oauth-secret respectively, sent to docktail.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
