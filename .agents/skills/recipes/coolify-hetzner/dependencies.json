{
  "coolify": "4.7.5",
  "hcloud": "1.70.2",
  "coolify_api": {
    "access": "REST over the tailnet to port 8000 with the person's team token; no proxy, no redirect",
    "writes": [
      "POST /api/v1/projects",
      "POST /api/v1/services",
      "POST /api/v1/services/{uuid}/envs",
      "PATCH /api/v1/services/{uuid}/envs",
      "POST /api/v1/services/{uuid}/start"
    ],
    "reads": [
      "GET /api/v1/version",
      "GET /api/v1/team",
      "GET /api/v1/servers/{uuid}",
      "GET /api/v1/servers/{uuid}/destinations",
      "GET /api/v1/services/{uuid}/envs",
      "GET /api/v1/projects",
      "GET /api/v1/services"
    ],
    "compose_encoding": "base64",
    "checked_against": "Coolify v4.7.5 routes/api.php and its Api controllers"
  },
  "docktail": {
    "image": "ghcr.io/marvinvr/docktail:1.8.6",
    "licence": "AGPL-3.0",
    "modified": false,
    "update_check": true,
    "update_check_reason": "Retain the recorded outbound version check until an off switch is verified for 1.8.6; disclose it in create and start approvals."
  },
  "canary": {
    "image": "traefik/whoami:v1.11.0",
    "purpose": "Empty-place tailnet connectivity check"
  },
  "checked_at": "2026-11-16",
  "coolify_helper": "1.0.19",
  "coolify_builtin_server": {
    "name": "localhost",
    "addresses": [
      "127.0.0.1",
      "localhost",
      "host.docker.internal"
    ],
    "destination_reply": "JSON list, including the coolify Standalone Docker with server_id 0"
  },
  "coolify_service_environment": {
    "compose_creates_empty_oauth_keys": true,
    "duplicate_create_status": 409,
    "update_method": "PATCH",
    "rows_selected_by": "key only, whatever the preview scope",
    "request_fields": [
      "key",
      "value",
      "is_literal",
      "is_multiline",
      "is_shown_once",
      "comment"
    ],
    "ignored_fields": "Any other field, including is_buildtime, is_runtime and is_preview, is dropped unread; the kit refuses to send one",
    "readback": "Local transport projects raw values to set or unset and deployment flags"
  },
  "coolify_files": {
    "install.sh": {
      "url": "https://raw.githubusercontent.com/coollabsio/coolify/v4.7.5/scripts/install.sh",
      "sha256": "c221f81e0bc9b47541f47bf671da76c79cfb61ce4741c3cb0800d7a18b99f137"
    },
    "upgrade.sh": {
