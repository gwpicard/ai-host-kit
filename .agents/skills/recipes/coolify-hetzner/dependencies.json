      "sha256": "d99cc100ce9e706d691980591aab6dee238eea59710ec8abacc84aedb79973d7"
    },
    "upgrade-postgres.sh": {
      "url": "https://raw.githubusercontent.com/coollabsio/coolify/v4.7.5/scripts/upgrade-postgres.sh",
      "sha256": "aa65c277fc13ab5b27c349fbfef12defc59c084b244e4b258329e1f6c570ae8d"
    },
    "docker-compose.yml": {
      "url": "https://raw.githubusercontent.com/coollabsio/coolify/v4.7.5/docker-compose.yml",
      "sha256": "2532ee9258e10ad4e86cb3c2b46c29fe9329f5a0dace0f7da410744feec279bd"
    },
    "docker-compose.prod.yml": {
      "url": "https://raw.githubusercontent.com/coollabsio/coolify/v4.7.5/docker-compose.prod.yml",
      "sha256": "f8b104aadfca48d0033fdee6cb87fea13c68bc5c67c63ba18b1934e9f901ff5d"
    },
    ".env.production": {
