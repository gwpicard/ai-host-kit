{
  "schema_version": "1.7",
  "tool": {
    "name": "leave-approvals",
    "owner": "Example owner",
    "successor": "Example successor"
  },
  "image": {
    "dockerfile": "Dockerfile"
  },
  "processes": {
    "web": {
      "command": "web",
      "port": 3000
    },
    "worker": null,
    "migrate": {
      "command": "migrate",
      "when": "before-release"
    }
  },
  "health": {
    "path": "/api/health",
    "checks": [
      "database"
    ],
    "commit_env": "SOURCE_COMMIT"
  },
  "config": [
    {
      "name": "DATABASE_URL",
      "kind": "secret",
      "phase": "runtime",
      "source": "host"
    },
    {
      "name": "AUTH_SECRET",
      "kind": "secret",
      "phase": "runtime",
      "source": "generated"
    }
  ],
  "postgres": {
    "min_major": 17,
    "extensions": [],
    "roles": {
      "migrate": "owner",
      "app": "no-owner-no-bypassrls"
    }
  },
  "files": {
    "port": "s3",
    "buckets": [
      {
        "name": "uploads",
        "private": true,
        "link_minutes": 15
      }
    ]
  },
  "email": {
    "transport": "smtp",
    "sender_domain": "example.invalid",
    "inbound": false
  },
  "jobs": {
    "library": "pg-boss",
    "runner": "host-tick",
    "longest_job_seconds": 900,
    "schedules": [
      {
        "name": "nightly-sync",
        "cron": "0 2 * * *"
      }
    ]
  },
  "sign_in": {
    "staff": {
      "provider": "google",
      "directory": "single-tenant",
      "outside_refused_test": "e2e/outside-account.spec.ts",
      "redirect_path": "/auth/callback"
    },
    "outsiders": "none"
  },
  "ai": {
    "needed": true,
    "capabilities": [
      "text",
      "pdf"
    ],
    "residency": "eu"
  },
  "access": "private",
  "residency": "eu",
  "data_risk": [
    "personal"
  ],
  "recovery": {
    "max_data_loss_hours": 24,
    "max_restore_hours": 8
  },
  "limits": {
    "longest_request_seconds": 30,
    "memory_mb": 512,
    "outbound_internet": true,
    "optional_limit": 123
  },
  "previews": {
    "wanted": true,
    "data": "separate-database"
  },
  "optional_note": {
    "unused": true
  }
}
