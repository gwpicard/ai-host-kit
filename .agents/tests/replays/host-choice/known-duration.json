{
  "name": "known-duration",
  "handover": {
    "schema_version": "1.0",
    "tool": {
      "name": "leave-approvals",
      "owner": "Example owner",
      "successor": "Example successor"
    },
    "image": {
      "dockerfile": "Dockerfile"
    },
    "processes": {
      "web": {
        "command": "web",
        "port": 3000
      },
      "worker": {
        "command": "worker"
      },
      "migrate": {
        "command": "migrate",
        "when": "before-release"
      }
    },
    "health": {
      "path": "/api/health",
      "checks": [
        "database",
        "worker"
      ],
      "commit_env": "SOURCE_COMMIT"
    },
    "config": [
      {
        "name": "DATABASE_URL",
        "kind": "secret",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "AUTH_SECRET",
        "kind": "secret",
        "phase": "runtime",
        "source": "generated"
      }
    ],
    "postgres": {
      "min_major": 17,
      "extensions": [],
      "roles": {
        "migrate": "owner",
        "app": "no-owner-no-bypassrls"
      }
    },
    "files": {
      "port": "s3",
      "buckets": [
        {
          "name": "uploads",
          "private": true,
          "link_minutes": 15
        }
      ]
    },
    "email": {
      "transport": "smtp",
      "sender_domain": "example.invalid",
      "inbound": false
    },
    "jobs": {
      "library": "pg-boss",
      "runner": "worker",
      "longest_job_seconds": 900,
      "schedules": [
        {
          "name": "nightly-sync",
          "cron": "0 2 * * *"
        }
      ]
    },
    "sign_in": {
      "staff": {
        "provider": "entra",
        "directory": "single-tenant",
        "outside_refused_test": "e2e/outside-account.spec.ts",
        "redirect_path": "/auth/callback"
      },
      "outsiders": "none"
    },
    "ai": {
      "needed": true,
      "capabilities": [
        "text",
        "pdf"
      ],
      "residency": "eu"
    },
    "access": "private",
    "residency": "eu",
    "data_risk": [
      "personal"
    ],
    "recovery": {
      "max_data_loss_hours": 24,
      "max_restore_hours": 8
    },
    "limits": {
      "longest_request_seconds": 30,
      "memory_mb": 512,
      "outbound_internet": true
    },
    "previews": {
      "wanted": true,
      "data": "separate-database"
    }
  },
  "place": null,
  "turns": [
    "Help me choose somewhere to run this tool.",
    "My answers are {\"cloud\": \"none\", \"care\": \"managed\"}. Please show the fit and your suggestion.",
    "Choose azure. Please record that choice."
  ],
  "expected": {
    "host": "azure",
    "answers": {
      "cloud": "none",
      "care": "managed"
    },
    "wish": null,
    "questions": [
      "cloud",
      "care"
    ],
    "warnings": 0,
    "acceptance": null,
    "outcomes": [
      "Before the person chooses a host, the transcript suggests the expected host with its trade-off and says not yet proven.",
      "Every fit need, including residency and unknowns, is visible.",
      "The local place-record.json validates and records the choice, answers, proof status and any wish.",
      "No provider is contacted and no infrastructure is created. The transcript says creating the place is not built yet.",
      "No question about long background work is asked; the handover supplies the duration."
    ]
  }
}
