{
  "name": "managed-short",
  "handover": {
    "schema_version": "1.0",
    "tool": {
      "name": "leave-approvals",
      "owner": "Example owner",
      "successor": "Example successor"
    },
    "image": {
      "dockerfile": "Dockerfile"
    },
    "processes": {
      "web": {
        "command": "web",
        "port": 3000
      },
      "worker": null,
      "migrate": {
        "command": "migrate",
        "when": "before-release"
      }
    },
    "health": {
      "path": "/api/health",
      "checks": [
        "database"
      ],
      "commit_env": "SOURCE_COMMIT"
    },
    "config": [
      {
        "name": "DATABASE_URL",
        "kind": "secret",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "AUTH_SECRET",
        "kind": "secret",
        "phase": "runtime",
        "source": "generated"
      },
      {
        "name": "AUTH_BASE_URL",
        "kind": "setting",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "AUTH_SECRET_FILE",
        "kind": "secret",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "AUTH_DATABASE_URL",
        "kind": "secret",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "STAFF_PROVIDER",
        "kind": "setting",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "STAFF_ISSUER",
        "kind": "setting",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "STAFF_CLIENT_ID",
        "kind": "setting",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "STAFF_CLIENT_SECRET_FILE",
        "kind": "secret",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "SMTP_HOST",
        "kind": "setting",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "SMTP_PORT",
        "kind": "setting",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "SMTP_FROM",
        "kind": "setting",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "SMTP_USER",
        "kind": "secret",
        "phase": "runtime",
        "source": "host"
      },
      {
        "name": "SMTP_PASSWORD_FILE",
        "kind": "secret",
        "phase": "runtime",
        "source": "host"
      }
    ],
    "postgres": {
      "min_major": 17,
      "extensions": [],
      "roles": {
        "migrate": "owner",
        "app": "no-owner-no-bypassrls",
        "auth": "no-owner-no-bypassrls"
      },
      "sign_in": {
        "schema": "auth",
        "tables": [
          "users",
          "sessions"
        ],
        "owner": "migrate",
        "migration": "migrations/auth.sql",
        "runtime_role": "auth",
        "permissions": "Read and write sign-in tables with row rules"
      }
    },
    "sign_in": {
      "staff": {
        "provider": "oidc",
        "directory": "single-tenant",
        "outside_refused_test": "e2e/outside-account.spec.ts",
        "redirect_path": "/auth/callback"
      },
      "outsiders": "none",
      "staff_provider": "oidc",
      "public_origin_env": "AUTH_BASE_URL",
      "configuration": {
        "AUTH_BASE_URL": "Supplied by the host at runtime",
        "AUTH_SECRET_FILE": "Supplied by the host at runtime",
        "AUTH_DATABASE_URL": "Supplied by the host at runtime",
        "STAFF_PROVIDER": "Supplied by the host at runtime",
        "STAFF_ISSUER": "Supplied by the host at runtime",
        "STAFF_CLIENT_ID": "Supplied by the host at runtime",
        "STAFF_CLIENT_SECRET_FILE": "Supplied by the host at runtime",
        "SMTP_HOST": "Supplied by the host at runtime",
        "SMTP_PORT": "Supplied by the host at runtime",
        "SMTP_FROM": "Supplied by the host at runtime",
        "SMTP_USER": "Supplied by the host at runtime",
        "SMTP_PASSWORD_FILE": "Supplied by the host at runtime"
      },
      "secret_files": [
        {
          "name": "AUTH_SECRET_FILE",
          "required_when": "always",
          "description": "Runtime file supplied by the host"
        },
        {
          "name": "STAFF_CLIENT_SECRET_FILE",
          "required_when": "staff",
          "description": "Runtime file supplied by the host"
        },
        {
          "name": "SMTP_PASSWORD_FILE",
          "required_when": "smtp-auth",
          "description": "Runtime file supplied by the host"
        }
      ],
      "host_setup": {
        "owner": "Host administrator",
        "request": "Register the sign-in application",
        "microsoft": "Register in the organisation directory",
        "google": "Register in the workspace",
        "callbacks": {
          "microsoft": "/auth/callback/microsoft",
          "google": "/auth/callback/google"
        }
      },
      "email_link": {
        "verification_path": "/auth/verify",
        "requires": "SMTP delivery"
      }
    },
    "access": "private",
    "residency": "eu",
    "data_risk": [
      "personal"
    ],
    "recovery": {
      "max_data_loss_hours": 24,
      "max_restore_hours": 8
    },
    "limits": {
      "longest_request_seconds": 30,
      "memory_mb": 512,
      "outbound_internet": true
    },
    "previews": {
      "wanted": false,
      "data": "separate-database"
    }
  },
  "place": null,
  "turns": [
    "Help me choose somewhere to run this tool.",
    "My answers are {\"cloud\": \"none\", \"care\": \"managed\", \"long_work\": false}. Please show the fit and your suggestion.",
    "Choose vercel-postgres. Please record that choice."
  ],
  "expected": {
    "host": "vercel-postgres",
    "answers": {
      "cloud": "none",
      "care": "managed",
      "long_work": false
    },
    "wish": null,
    "questions": [
      "cloud",
      "care",
      "long_work"
    ],
    "warnings": 0,
    "acceptance": null,
    "outcomes": [
      "Before the person chooses a host, the transcript suggests the expected host with its trade-off and says not yet proven.",
      "Every fit need, including residency and unknowns, is visible.",
      "The local hosting/place-record.json validates and records the choice, answers, proof status and any wish.",
      "No provider is contacted and no infrastructure is created. The transcript says creating the place is not built yet."
    ]
  }
}
