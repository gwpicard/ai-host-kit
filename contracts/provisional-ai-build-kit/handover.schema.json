{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional handover v1 for AI Build Kit to adopt",
  "description": "Provisional draft only. AI Build Kit owns the canonical schema once published; AI Host Kit will vendor that copy unchanged. This draft proves no agreement with a published release.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "successor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "owner"
      ],
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "properties": {
        "dockerfile": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s\\\\]+$"
        }
      },
      "required": [
        "dockerfile"
      ],
      "additionalProperties": true
    },
    "processes": {
      "type": "object",
      "properties": {
        "web": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "command",
            "port"
          ],
          "additionalProperties": true
        },
        "worker": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "migrate": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "when": {
              "const": "before-release"
            }
          },
          "required": [
            "command",
            "when"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "web",
        "migrate"
      ],
      "additionalProperties": true
    },
    "health": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\s?#]*$"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "database",
              "worker"
            ]
          },
          "uniqueItems": true
        },
        "commit_env": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "required": [
        "path",
        "checks",
        "commit_env"
      ],
      "additionalProperties": true
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "secret",
              "setting"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "build",
              "runtime"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "generated",
              "person",
              "host"
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "phase",
          "source"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "secret"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "phase": {
                  "const": "runtime"
                }
              }
            }
          }
        ],
        "description": "Declare names and where they come from. Never put values here. Secret names are supplied at runtime."
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "min_major": {
          "type": "integer",
          "minimum": 1
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "object",
          "properties": {
            "migrate": {
              "const": "owner"
            },
            "app": {
              "const": "no-owner-no-bypassrls",
              "description": "The app role owns no table and cannot bypass row-level security."
            }
          },
          "required": [
            "migrate",
            "app"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "min_major",
        "extensions",
        "roles"
      ],
      "additionalProperties": true
    },
    "files": {
      "type": "object",
      "properties": {
        "port": {
          "type": "string",
          "enum": [
            "s3",
            "azure-blob"
          ]
        },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "private": {
                "type": "boolean"
              },
              "link_minutes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "name",
              "private",
              "link_minutes"
            ],
            "additionalProperties": true
          },
          "minItems": 1
        }
      },
      "required": [
        "port",
        "buckets"
      ],
      "additionalProperties": true
    },
    "email": {
      "type": "object",
      "properties": {
        "transport": {
          "const": "smtp"
        },
        "sender_domain": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}$"
        },
        "inbound": {
          "type": "boolean"
        }
      },
      "required": [
        "transport",
        "sender_domain",
        "inbound"
      ],
      "additionalProperties": true
    },
    "jobs": {
      "type": "object",
      "properties": {
        "library": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "enum": [
            "worker",
            "in-app",
            "host-tick"
          ]
        },
        "longest_job_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "schedules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "cron": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S+(?:[ \\t]+\\S+){4}$"
              }
            },
            "required": [
              "name",
              "cron"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "library",
        "runner",
        "longest_job_seconds",
        "schedules"
      ],
      "additionalProperties": true
    },
    "sign_in": {
      "type": "object",
      "properties": {
        "staff": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "entra",
                "google",
                "oidc"
              ]
            },
            "directory": {
              "type": "string",
              "minLength": 1
            },
            "outside_refused_test": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s\\\\]+$"
            },
            "redirect_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^/[^\\s?#]*$"
            }
          },
          "required": [
            "provider",
            "directory",
            "outside_refused_test"
          ],
          "additionalProperties": true
        },
        "outsiders": {
          "type": "string",
          "enum": [
            "email-link",
            "none"
          ]
        }
      },
      "required": [
        "staff",
        "outsiders"
      ],
      "additionalProperties": true
    },
    "ai": {
      "type": "object",
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "vision",
              "pdf"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "residency": {
          "type": "string",
          "enum": [
            "uk",
            "eu",
            "any"
          ]
        }
      },
      "required": [
        "needed"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "needed": {
                "const": true
              }
            },
            "required": [
              "needed"
            ]
          },
          "then": {
            "required": [
              "capabilities",
              "residency"
            ]
          }
        }
      ]
    },
    "access": {
      "type": "string",
      "enum": [
        "private",
        "invitation",
        "public"
      ]
    },
    "residency": {
      "type": "string",
      "enum": [
        "uk",
        "eu",
        "any"
      ]
    },
    "data_risk": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "recovery": {
      "type": "object",
      "properties": {
        "max_data_loss_hours": {
          "type": "number",
          "minimum": 0
        },
        "max_restore_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "max_data_loss_hours",
        "max_restore_hours"
      ],
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "longest_request_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "outbound_internet": {
          "type": "boolean"
        }
      },
      "required": [
        "longest_request_seconds",
        "memory_mb",
        "outbound_internet"
      ],
      "additionalProperties": true
    },
    "previews": {
      "type": "object",
      "properties": {
        "wanted": {
          "type": "boolean"
        },
        "data": {
          "const": "separate-database"
        }
      },
      "required": [
        "wanted",
        "data"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "tool",
    "image",
    "processes",
    "health",
    "config",
    "postgres",
    "sign_in",
    "access",
    "residency",
    "data_risk",
    "recovery",
    "limits",
    "previews"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "jobs": {
            "properties": {
              "runner": {
                "const": "worker"
              }
            },
            "required": [
              "runner"
            ]
          }
        },
        "required": [
          "jobs"
        ]
      },
      "then": {
        "properties": {
          "processes": {
            "required": [
              "worker"
            ],
            "properties": {
              "worker": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sign_in": {
            "properties": {
              "outsiders": {
                "const": "email-link"
              }
            },
            "required": [
              "outsiders"
            ]
          }
        },
        "required": [
          "sign_in"
        ]
      },
      "then": {
        "required": [
          "email"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "access": {
            "enum": [
              "private",
              "invitation"
            ]
          }
        },
        "required": [
          "access"
        ]
      },
      "then": {
        "properties": {
          "files": {
            "properties": {
              "buckets": {
                "items": {
                  "properties": {
                    "private": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
